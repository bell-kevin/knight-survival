{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Build",
            "type": "shell",
            "command": "cmake -B build -DCMAKE_BUILD_TYPE=Debug && cmake --build build -j",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Web Build (Emscripten)",
            "type": "shell",
            "command": "emcmake cmake -B build-web -DCMAKE_BUILD_TYPE=Release && cmake --build build-web -j",
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Serve Web Build on http://localhost:8080",
            "type": "shell",
            "command": "python3 -m http.server -d build-web/site 8080",
            "isBackground": true,
            "problemMatcher": []
        }
    ]
}
